# Copy this file to .env and fill in real values locally.

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_MODE=api
AI_ANALYSIS_PROMPT_FILE=artifacts/ai_prompt.json
AI_ANALYSIS_RESPONSE_FILE=artifacts/ai_response.json
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:14b
OPENAI_TIMEOUT_SECONDS=45
TRADING_TERMINAL_ENABLED=true
